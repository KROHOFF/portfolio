---
import { NAVIGATION } from "../consts";

const currentPath = Astro.url.pathname;
---

<header
  class="header z-50 backdrop-blur-2xl bg-foreground/1 fixed left-[50%] -translate-x-1/2 w-full flex justify-center items-center"
>
  <div
    class="animate-pulsing hidden md:block absolute left-[10%] top-[50%] -translate-y-1/2"
  >
    <span class="font-bold text-secondary tracking-[0.25rem]">
      <span class="text-primary">C</span>LEHUE
    </span>
  </div>
  <nav class="sticky top-0 w-full md:w-auto">
    <ul
      class="flex justify-start md:justify-center items-center h-14 overflow-x-auto scrollbar-none px-4 md:px-0 gap-2 md:gap-1"
    >
      {
        NAVIGATION.map((item) => (
          <li
            class="nav-item border-b border-b-transparent relative py-3 shrink-0 animate-slide-in-bottom animate-delay-150"
            data-section={item.id === "home" ? "hero" : item.id}
          >
            <a
              href={item.path}
              data-section={item.id === "home" ? "hero" : item.id}
              class={`relative py-4.5 tracking-widest text-xs transition-all px-5 md:px-10 ${currentPath === item.path ? "text-primary border-r border-secondary/5" : "border-transparent text-secondary hover:text-amber-300"}`}
            >
              {item.name}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script is:inline>
  function initMenu() {
    const nav = document.querySelectorAll(".nav-item");
    const navList = document.querySelector("nav ul");
    let isSmoothScrollInProgress = false;

    function centerActiveItem(sectionId) {
      if (!navList) return;

      const activeItem = document.querySelector(
        `.nav-item[data-section="${sectionId}"]`,
      );

      if (!activeItem) return;

      const itemLeft = activeItem.offsetLeft;
      const itemWidth = activeItem.offsetWidth;
      const listWidth = navList.clientWidth;
      const scrollLeft = itemLeft - listWidth / 2 + itemWidth / 2;

      navList.scrollTo({
        left: scrollLeft,
        behavior: "smooth",
      });
    }

    function setActiveNav(sectionId) {
      nav.forEach((n) => {
        const link = n.querySelector("a");
        const isActive = n.dataset.section === sectionId;

        n.dataset.active = String(isActive);

        if (!link) return;

        link.classList.toggle("text-primary", isActive);
        link.classList.toggle("border-r", isActive);
        link.classList.toggle("border-secondary/5", isActive);
        link.classList.toggle("text-secondary", !isActive);
        link.classList.toggle("border-transparent", !isActive);

        n.classList.toggle("border-b-amber-300", isActive);
        n.classList.toggle("duration-500", isActive);
        n.classList.toggle("border-b-transparent", !isActive);
      });

      centerActiveItem(sectionId);
    }

    function getCurrentSectionId() {
      const sections = Array.from(document.querySelectorAll("section[id]"));
      if (!sections.length) return "hero";

      const headerOffset = 90;

      if (window.scrollY <= 20) return "hero";

      let currentId = "hero";

      sections.forEach((section) => {
        const rect = section.getBoundingClientRect();
        const sectionTop = rect.top;
        const sectionBottom = rect.bottom;

        if (
          sectionTop <= headerOffset + 10 &&
          sectionBottom > headerOffset + 20
        ) {
          currentId = section.id;
        }
      });

      return currentId;
    }

    function updateActiveSection() {
      if (isSmoothScrollInProgress) return;
      setActiveNav(getCurrentSectionId());
    }

    function activityHoverMenu(activeMenu) {
      nav.forEach((n) => {
        const isActive = n.dataset.active === "true";

        if (isActive) {
          n.classList.add("border-b-amber-300", "duration-500");
          n.classList.remove("border-b-transparent");
          return;
        }

        if (!activeMenu) {
          n.classList.remove("border-b-amber-300", "duration-500");
          n.classList.add("border-b-transparent");
        } else if (n === activeMenu) {
          n.classList.add("border-b-amber-300", "duration-500");
          n.classList.remove("border-b-transparent");
        } else {
          n.classList.add("border-b-transparent");
          n.classList.remove("border-b-amber-300", "duration-500");
        }
      });
    }

    nav.forEach((n) => {
      const link = n.querySelector("a");

      if (link) {
        link.addEventListener("click", (event) => {
          const sectionId = n.dataset.section;
          if (!sectionId) return;

          event.preventDefault();

          if (sectionId === "hero") {
            window.scrollTo({ top: 0, behavior: "smooth" });
            setActiveNav("hero");
            return;
          }

          const section = document.getElementById(sectionId);
          if (section) {
            const headerOffset = 90;
            const sectionTop =
              section.getBoundingClientRect().top +
              window.scrollY -
              headerOffset;

            isSmoothScrollInProgress = true;
            setActiveNav(sectionId);
            requestAnimationFrame(() => centerActiveItem(sectionId));

            window.scrollTo({
              top: sectionTop,
              behavior: "smooth",
            });

            window.setTimeout(() => {
              isSmoothScrollInProgress = false;
              updateActiveSection();
            }, 900);
          }

          setActiveNav(sectionId);
          requestAnimationFrame(() => centerActiveItem(sectionId));
        });
      }

      n.addEventListener("mouseenter", () => {
        if (n.dataset.active !== "true") {
          activityHoverMenu(n);
        }
      });

      n.addEventListener("mouseleave", () => {
        if (n.dataset.active !== "true") {
          activityHoverMenu(null);
        }
      });
    });

    updateActiveSection();
    window.addEventListener("scroll", updateActiveSection, { passive: true });
    window.addEventListener("resize", updateActiveSection);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initMenu);
  } else {
    initMenu();
  }
</script>
