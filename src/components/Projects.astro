---
import { PROJECTS } from "@/consts";
import Title from "./Title.astro";
---

<section class="w-full p-10" id="projects">
  <div class="max-w-7xl mx-auto">
    <Title title="Projects" />
  </div>
  <div class="max-w-7xl mx-auto grid grid-cols-2 gap-5 mt-5">
    {
      PROJECTS.map((project, i) => (
        <article class="relative border border-card hover:border-accent overflow-hidden grayscale-100 hover:grayscale-0 transition-all duration-500 cursor-pointer">
          <div class=" inset-0 w-full h-full ">
            {project.srcImg && (
              <div class="flex justify-center items-center w-full h-full">
                <img
                  src={project.srcImg}
                  alt={project.name}
                  class="h-full w-full object-cover"
                />
              </div>
            )}
            <div class="absolute left-0 bottom-0 flex flex-col gap-2">
              <span class="font-semibold">{project.name}</span>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
