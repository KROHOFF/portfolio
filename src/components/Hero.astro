---
import EsferaNombre from "./EsferaNombre.astro";
import GithubGrid from "./GithubActivity.jsx";
---

<section class="w-full" id="hero">
  <div class="max-w-7xl mx-auto p-5 md:p-10">

    <div class="relative flex justify-center items-center py-5 md:py-10">
      <img
        src="/logo/1x/cl-white.png"
        alt="logoCL"
        draggable="false"
        class="absolute left-[50%] transform -translate-x-1/2 w-10 md:w-13 opacity-90"
      />
      <div
        class="bg-accent blur-xl opacity-30 absolute h-14 w-14 md:h-20 md:w-20 left-[50%] transform -translate-x-1/2 rounded-full"
      >
      </div>

      <div
        class="relative w-2/3 md:w-1/3 flex justify-center items-center transition-transform duration-500"
      >
        <EsferaNombre texto="C A M I L O  L E H U E  I G O R - " />
      </div>
    </div>

    <div class="relative text-center flex flex-col justify-center items-center">
      <div class="relative max-w-md flex justify-center items-center flex-col">
        <span class="mb-4 md:mb-6 text-base md:text-xl font-light tracking-[0.3rem] md:tracking-[0.5rem] leading-8 md:leading-10"
          >Software Engineer</span
        >
      </div>
      <div>
        <p class="text-secondary text-[10px] md:text-xs font-light leading-5 md:leading-6 max-w-2xl">
          Sistemas complejos especializados
        </p>
      </div>
    </div>
  </div>

