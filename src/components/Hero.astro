<section class="w-full" id="hero">
  <div class="max-w-7xl mx-auto p-10">
    <div class="relative flex justify-center items-center py-10">
      <div
        class="border absolute h-45 w-45 left-[50%] transform -translate-x-1/2 rounded-full"
      >
      </div>
      <div
        class="bg-accent blur-xl opacity-30 absolute h-20 w-20 left-[50%] transform -translate-x-1/2 rounded-full"
      >
      </div>

      <div
        class="relative w-1/3 flex justify-center items-center hover:scale-95 transition-transform duration-500"
      >
        <EsferaNombre texto="C A M I L O  L E H U E  I G O R - " />
      </div>
    </div>

    <div class="relative text-center flex flex-col justify-center items-center">
      <div class="relative max-w-md flex justify-center items-center flex-col">
        <span class="mb-6 text-xl font-light tracking-[0.5rem] leading-10"
          >Software Engineer</span
        >
      </div>
      <div>
        <p class="text-secondary text-xs font-light leading-6 max-w-2xl">
          Desarrollador de sistemas avanzados, 
        </p>
      </div>
    </div>
  </div>
