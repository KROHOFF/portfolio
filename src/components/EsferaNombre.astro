---
export interface Props {
  texto: string;
  animar?: boolean;
}

const { texto, animar = true } = Astro.props;
---

<div class="logo-container -rotate-73">
  <svg viewBox="0 0 500 500" class={`circular-text ${animar ? "animado" : ""}`}>
    <defs>
      <path
        id="circlePath"
        d="M 250, 250 m -180, 0 a 180,180 0 1,1 360,0 a 180,180 0 1,1 -360,0"
      ></path>

      <linearGradient id="rainbowGradient" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#ffffff"></stop>
        <stop offset="20%" stop-color="#e5e5e5"></stop>
        <stop offset="40%" stop-color="#a8a8a8"></stop>
        <stop offset="60%" stop-color="#ffffff"></stop>
        <stop offset="80%" stop-color="#a8a8a8"></stop>
        <stop offset="100%" stop-color="#e5e5e5"></stop>
      </linearGradient>
    </defs>

    <text fill="url(#rainbowGradient)" class="text-style">
      <textPath href="#circlePath" startOffset="0%">
        {texto}
      </textPath>
    </text>
  </svg>
</div>

<style>
  .circular-text {
    width: 100%;
    height: auto;
  }
  .text-style {
    font-size: 30px;
    letter-spacing: 23px;
  }
</style>
