---
import { SOCIALS } from "../consts";
import Title from "./Title.astro";
---

<section id="contact">
  <div class="max-w-7xl mx-auto py-10 flex flex-col gap-5">
    <Title title="Contact me" />
    <div class="flex justify-center items-center gap-5">
      {
        SOCIALS.map((social) => (
          <a
            href={social.url}
            target="_blank"
            rel="noopener noreferrer"
            class="flex bg-foreground shadow border border-t-primary py-1 hover:bg-primary rounded-full text-primary-foreground px-5 items-center gap-2 mb-5 hover:text-accent transition-colors duration-300"
          >
            <span class="text-sm">{social.name}</span>
          </a>
        ))
      }
    </div>
  </div>
</section>
